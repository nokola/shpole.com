{
    "compilerOptions": {
        "target": "ES2022",
        "module": "node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": ".",
        "declaration": false,
        "resolveJsonModule": true
    },
    "include": [
        "server/**/*.ts",
        "server.ts"
    ],
    "exclude": [
        "node_modules",
        "build",
        ".svelte-kit"
    ]
}